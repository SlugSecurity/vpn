server:
  listenAddress: ":80"
  exposedAddress: https://connect.vpn.slugsec.club:443
  stunPorts:
    - 3478

  dataDir: /var/lib/netbird
  logLevel: info
  logFile: console
  disableAnonymousMetrics: true
  disableGeoliteUpdate: true

  authSecret: ${NETBIRD_RELAY_SECRET}

  auth:
    issuer: https://vpn.slugsec.club/oauth2
    signKeyRefreshEnabled: true
    sessionCookieEncryptionKey: ${NETBIRD_COOKIE_KEY}
    dashboardRedirectURIs:
      - https://vpn.slugsec.club/#callback
      - https://vpn.slugsec.club/#silent-callback
    dashboardPostLogoutRedirectURIs:
      - https://vpn.slugsec.club/
    cliRedirectURIs:
      - http://localhost:53000/

  reverseProxy:
    trustedHTTPProxies:
      - 172.29.76.2/32
      - 172.29.76.1/32
    trustedPeers:
      - 172.29.76.2/32
      - 172.29.76.1/32

  store:
    engine: sqlite
    encryptionKey: ${NETBIRD_STORE_KEY}
